// Sahra Worker configuration.
// Production deploys only from `main` (Workers Builds). Preview builds must stay
// DISABLED for this Worker, because previews of the same Worker could reach live data.
// Staging is a separate Worker ("sahra-staging") with its own D1 and R2 (env.staging).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sahra",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Pages and static files are served as static assets: they do not invoke the Worker.
  // Anything not matching a file (all /api/* routes) runs the Worker.
  "assets": { "directory": "./public", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "vars": {
    // Set after the first deploy to the exact https://sahra.<subdomain>.workers.dev address.
    "PUBLIC_ORIGIN": "https://sahra.REPLACE-ME.workers.dev",
    // Set after the Google OAuth client is created (the client ID is not a secret).
    "GOOGLE_CLIENT_ID": "REPLACE-ME.apps.googleusercontent.com",
    // "1" only for Checkpoint A (scan prototype endpoints). Removed in Phase 2.
    "ENABLE_PROTO": "1"
  },
  // Secrets (set by the owner in the Cloudflare dashboard, never committed):
  //   GOOGLE_CLIENT_SECRET, QR_MASTER_K1, LINK_MASTER_K1
  "d1_databases": [
    { "binding": "DB", "database_name": "sahra-prod", "database_id": "REPLACE-WITH-PROD-D1-ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "sahra-prod" }
  ],
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "41001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_SCAN", "namespace_id": "41002", "simple": { "limit": 120, "period": 60 } }
  ],
  "env": {
    "staging": {
      "name": "sahra-staging",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "assets": { "directory": "./public", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
      "vars": {
        "PUBLIC_ORIGIN": "https://sahra-staging.REPLACE-ME.workers.dev",
        "GOOGLE_CLIENT_ID": "REPLACE-ME.apps.googleusercontent.com",
        "ENABLE_PROTO": "1"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "sahra-staging", "database_id": "REPLACE-WITH-STAGING-D1-ID", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "BUCKET", "bucket_name": "sahra-staging" }
      ],
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "42001", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_SCAN", "namespace_id": "42002", "simple": { "limit": 120, "period": 60 } }
      ]
    }
  }
}
